# Host processes bind to loopback; PostgreSQL and MinIO are provided by Docker.
FEI_API_HOST=127.0.0.1
FEI_API_PORT=8000
FEI_DATABASE_URL=postgresql+psycopg://fei:fei-local@127.0.0.1:5432/fei
FEI_MINIO_ENDPOINT=http://127.0.0.1:9000
FEI_MINIO_ACCESS_KEY=fei-local
FEI_MINIO_SECRET_KEY=change-me-local-only
FEI_MINIO_BUCKET=fei-private
FEI_MINIO_SECURE=false

